+function wordCount(content) {
+  const segmenter = new Intl.Segmenter(undefined, { granularity: 'word' });
+  let count = 0;
+  for (const line of String(content).replace(/\]\([^)]*\)/g, ']').split('\n')) {
+    for (const part of segmenter.segment(line)) if (part.isWordLike) count += 1;
+  }
+  return count;
